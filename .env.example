# Required: Gemini API key (get one at https://aistudio.google.com/apikey)
GOOGLE_API_KEY=your-gemini-api-key-here

# Model to use (must support multimodal / PDF input)
MODEL_NAME=gemini-2.0-flash

# SQLite state file path (created automatically on first run)
STATE_DB_PATH=./mortgage_agent_state.db

# --- Optional: Vertex AI instead of Gemini API key ---
# Uncomment these and remove GOOGLE_API_KEY to use Vertex AI
# GOOGLE_GENAI_USE_VERTEXAI=TRUE
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=global

# --- Optional: GCS document fallback ---
# Only needed if using "process from GCS" in prompts
# Requires: uv sync --extra gcs
# GCS_DATA_BUCKET=your-project-id-small-business-loan-data
