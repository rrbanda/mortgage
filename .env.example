# ---------------------------------------------------------------------------
# MaaS (recommended) — OpenAI-compatible Gemini endpoint, no GCP account needed
# ---------------------------------------------------------------------------
MAAS_BASE_URL=https://maas.apps.ocp.qn6c5.sandbox1388.opentlc.com
MAAS_API_KEY=your-maas-api-key-here

# Set to "true" only when the MaaS endpoint has a valid CA-signed TLS cert
MAAS_SSL_VERIFY=false

# Path template for per-model routing (override if your proxy uses a different convention)
# {model} is replaced with the model name at runtime
MAAS_URL_PATH=/gemini-external/{model}/v1

# ---------------------------------------------------------------------------
# Model
# ---------------------------------------------------------------------------
MODEL_NAME=gemini-2.5-flash

# ---------------------------------------------------------------------------
# SQLite state storage (created automatically on first run)
# ---------------------------------------------------------------------------
STATE_DB_PATH=./small_business_loan_agent.db

# ---------------------------------------------------------------------------
# Alternative: plain Gemini API key (instead of MaaS)
# Remove MAAS_BASE_URL / MAAS_API_KEY and set this:
# ---------------------------------------------------------------------------
# GOOGLE_API_KEY=your-gemini-api-key-here

# ---------------------------------------------------------------------------
# Alternative: Vertex AI (instead of MaaS or plain API key)
# Remove MAAS_* and GOOGLE_API_KEY, then set:
# ---------------------------------------------------------------------------
# GOOGLE_GENAI_USE_VERTEXAI=TRUE
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=global

# ---------------------------------------------------------------------------
# Business rules (all optional — defaults shown)
# ---------------------------------------------------------------------------

# Interest rates per risk tier (percentage)
RATE_TIER_1=6.50
RATE_TIER_2=7.75
RATE_TIER_3=9.25
RATE_TIER_4=11.00

# Default loan term when not specified in application (months)
DEFAULT_LOAN_TERM_MONTHS=60

# Compliance window for post-approval insurance verification (days)
INSURANCE_VERIFICATION_DAYS=30

# Branding / white-labelling
BANK_NAME=Cymbal Bank

# Loan request ID prefix — change if your system uses a different prefix (e.g. MBL, LN)
LOAN_ID_PREFIX=SBL

# Path to eligibility rules JSON (defaults to the bundled file)
# ELIGIBILITY_RULES_PATH=/path/to/your/eligibility_rules.json

# ── AutoRAG / OGX vector store (optional — enables live eligibility rule retrieval) ──
# Run tools/seed_autorag.py once to populate the vector store and get the ID.
# When both vars are set, the UnderwritingAgent retrieves rules dynamically instead
# of loading the static eligibility_rules.json file.
AUTORAG_BASE_URL=https://autorag-ogx-autorag.apps.ocp.qn6c5.sandbox1388.opentlc.com
AUTORAG_VECTOR_STORE_ID=
AUTORAG_SSL_VERIFY=false
